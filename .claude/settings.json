{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "anthropics-claude-code": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "agentdatamodels-local": {
      "source": {
        "source": "directory",
        "path": ".claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@anthropics-claude-code": true,
    "feature-dev@anthropics-claude-code": true,
    "commit-commands@anthropics-claude-code": true,
    "code-review@anthropics-claude-code": true,
    "pr-review-toolkit@anthropics-claude-code": true,
    "claude-md-management@anthropics-claude-code": true,
    "plugin-dev@anthropics-claude-code": true,
    "agent-sdk-dev@anthropics-claude-code": true,
    "mcp-server-dev@anthropics-claude-code": true,
    "skill-creator@anthropics-claude-code": true,
    "hookify@anthropics-claude-code": true,
    "claude-code-setup@anthropics-claude-code": true,
    "ralph-loop@anthropics-claude-code": true,
    "session-report@anthropics-claude-code": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "docs-lsp@agentdatamodels-local": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/bootstrap-services.sh",
            "timeout": 30,
            "statusMessage": "Starting Postgres + Redis data plane..."
          },
          {
            "type": "agent",
            "prompt": "Run every eval under $CLAUDE_PROJECT_DIR/src/web/prompt-evals/decisions/*.eval.md. For each file, follow its Check + Scorer + Skip sections exactly. Return one line of JSON per eval: {\"id\":\"D<N>\",\"ok\":bool,\"reason\":str}. Never mutate files in src/web/, .claude/, or the repo root — these evals are read-only. Session continues regardless of results; this is advisory.",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
